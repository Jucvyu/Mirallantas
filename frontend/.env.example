# Copia este archivo como frontend/.env solo si la API no está en la
# dirección por defecto. Vite solo expone variables que empiezan por VITE_.
# frontend/.env está en .gitignore.
#
# Las variables de Vite se leen al COMPILAR: en Vercel se escriben en
# Settings → Environment Variables y hay que volver a desplegar para que cuenten.
#
# Frontend publicado: https://mirallantas.vercel.app

# Dirección de la API (backend), terminada en /api.
# Local:       http://localhost:3000/api
# PRODUCCIÓN:  https://TU-API.onrender.com/api   (la dirección https de tu API desplegada)
VITE_API_URL=http://localhost:3000/api
