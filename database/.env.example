# Los scripts de la base leen primero backend/.env y después este archivo
# (database/.env), que tiene prioridad. Normalmente basta con backend/.env.
# Úsalo solo si la base que quieres tocar es otra, por ejemplo para migrar
# la de producción desde tu equipo. database/.env está en .gitignore.

# PostgreSQL. Con `npm run db` se levanta uno local en localhost:5433 usando
# exactamente este usuario, clave y base (solo para desarrollo).
DATABASE_URL=postgres://mirallantas:mirallantas@localhost:5433/mirallantas
