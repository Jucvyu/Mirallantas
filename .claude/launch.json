{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mirallantas-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "mirallantas-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "api"
      ],
      "port": 3000,
      "env": {
        "CORS_ORIGINS": "http://localhost:5173",
        "DATABASE_URL": "postgres://mirallantas:mirallantas@localhost:5433/mirallantas",
        "DATABASE_SSL": "false"
      }
    },
    {
      "name": "mirallantas-db",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "db"
      ],
      "port": 5433,
      "env": {
        "DATABASE_URL": "postgres://mirallantas:mirallantas@localhost:5433/mirallantas"
      }
    }
  ]
}
