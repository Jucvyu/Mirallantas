{
  "name": "mirallantas-api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de MiraLlantas ERP (Express + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
