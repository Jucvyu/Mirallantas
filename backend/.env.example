# Copia este archivo como backend/.env y ajusta los valores.
# backend/.env está en .gitignore: nunca lo subas al repositorio.
#
# EN PRODUCCIÓN (Render, Railway…) no se sube ningún archivo: cada variable
# se escribe en el panel del proveedor. Los valores de producción van en los
# comentarios "PRODUCCIÓN:" de cada variable.
# Frontend publicado: https://mirallantas.vercel.app

# PRODUCCIÓN: production
NODE_ENV=development
# En Render/Railway el puerto lo pone el proveedor (no definas PORT)
PORT=3000

# PostgreSQL. Con `npm run db` (desde la raíz) se levanta uno en localhost:5433 usando
# exactamente este usuario, clave y base (solo para desarrollo).
DATABASE_URL=postgres://mirallantas:mirallantas@localhost:5433/mirallantas
# PRODUCCIÓN: la dirección que te da la base en la nube, p. ej.
#   postgres://usuario:clave@host.neon.tech/mirallantas?sslmode=require
# SSL hacia PostgreSQL: true (verifica el certificado; úsalo en producción),
# no-verify (cifra sin verificar; solo si el proveedor lo exige) o false (local)
# PRODUCCIÓN: true
DATABASE_SSL=false

# Clave para firmar las sesiones. Mínimo 32 caracteres, distinta en cada
# entorno. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración máxima de una sesión (el frontend además la cierra tras 30 min sin uso)
JWT_EXPIRES_IN=8h

# Clave para cifrar datos sensibles en la base (secretos del doble factor).
# Mínimo 32 caracteres y DISTINTA de JWT_SECRET. Genérala igual que la anterior.
# Si la pierdes, quien tenga el doble factor activo deberá configurarlo de nuevo.
CLAVE_CIFRADO=

# true obliga al Administrador a activar la verificación en dos pasos.
# Por ahora es opcional (false); se puede activar desde "Mi perfil".
EXIGIR_2FA_ADMIN=false

# Cloudinary (imágenes subidas). Obligatorio en producción. Cópialo del panel
# de Cloudinary → API Keys → "API environment variable". Formato:
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Sin él (solo desarrollo) las imágenes se guardan dentro de la base.
CLOUDINARY_URL=

# Orígenes del frontend autorizados (separados por coma, sin "/" al final).
# PRODUCCIÓN: https://mirallantas.vercel.app  (en producción solo se admite https)
# Si luego agregas un dominio propio, ponlo aquí también, separado por coma.
CORS_ORIGINS=http://localhost:5173

# Zona horaria del negocio: define qué día es "hoy"
APP_TIMEZONE=America/Bogota

# Correo con Resend (https://resend.com): solo el enlace de "¿Olvidaste tu contraseña?".
# Obligatorio en producción. Sin clave (desarrollo) el enlace sale en la consola de la API.
# 1. Crea la cuenta en Resend y verifica tu dominio (Domains → Add domain, registros DNS).
# 2. API Keys → Create API Key (permiso "Sending access"). Va solo aquí, nunca en el frontend.
RESEND_API_KEY=
# Remitente de un dominio VERIFICADO en Resend (sin dominio propio, Resend solo deja
# enviar a tu propio correo de prueba desde onboarding@resend.dev).
# PRODUCCIÓN: "MiraLlantas <no-responder@tu-dominio.com>"
CORREO_REMITENTE="MiraLlantas <no-responder@tu-dominio.com>"

# Dirección pública del frontend, sin "/" al final: con ella se arma el enlace del correo.
# PRODUCCIÓN: https://mirallantas.vercel.app  (en producción debe ser https)
FRONTEND_URL=http://localhost:5173
